# Copy this file to .env and change the secrets. Never commit .env.

# --- Database / queue (host names match docker-compose services) ---
POSTGRES_USER=koyla
POSTGRES_PASSWORD=koyla
POSTGRES_DB=koyla
DATABASE_URL=postgresql+psycopg://koyla:koyla@db:5432/koyla
REDIS_URL=redis://redis:6379/0

# --- Storage ---
STORAGE_DIR=/data/files
MAX_UPLOAD_MB=100

# --- Local LLM (Ollama for dev, vLLM for deployment) ---
LLM_BASE_URL=http://ollama:11434
# 3B for laptops without a GPU (guide 4.3); use qwen2.5:7b-instruct on the demo machine
LLM_MODEL=qwen2.5:3b-instruct
LLM_NUM_CTX=8192
EMBED_MODEL=bge-m3
OCR_ENGINE=paddle            # paddle | tesseract
EXTRACT_USE_LLM=true         # LLM names a table's metric only when keyword rules can't
ALLOW_EXTERNAL_CALLS=false
TOPICS_MIN_NEW_PQS=5         # re-build the topics after this many new Parliament Questions

# --- Auth ---
JWT_SECRET=change-me-to-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:3000

# --- Seed script (demo users only; change before any shared deployment) ---
SEED_DEMO_PASSWORD=change-me-too

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
